APP_NAME="Can Eye Budget"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
CACHE_PREFIX=
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=150

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PREFIX=
HORIZON_PREFIX=
HORIZON_AUTHORIZED_EMAILS=

FILESYSTEM_DISK=local

FORTIFY_REGISTRATION_ENABLED=false

REDBARK_BASE_URL=https://api.redbark.com/v1
REDBARK_INCLUDE_PENDING=false
REDBARK_HOLD_TTL_DAYS=14

SENTRY_LARAVEL_DSN=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

BUDGET_RECURRING_DETECTION=false
BUDGET_BNPL_EMAIL_IMPORT=false
AUDIT_RETENTION_DAYS=365

RAY_ENABLED=false
BOOST_ENABLED=false

CONTAINER_ROLE=web
