#!/usr/bin/env bash
# Bootstrap a linked git worktree so `ddev exec --dir` can run tests in it.
# Run from the worktree root. Idempotent. Never touches the main checkout.
#
# DDEV only mounts the project root (/var/www/html) and the OMP worktree base
# (/omp-wt, see .ddev/docker-compose.omp-worktrees.yaml). ddev is always run
# from the main checkout so the worktree's own .ddev/ is never consulted.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WT="$(git rev-parse --show-toplevel)"
MAIN="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"

if [ "$WT" = "$MAIN" ]; then
    echo "worktree-setup: run this inside a linked worktree, not the main checkout" >&2
    exit 1
fi

CPATH="$("$HERE/worktree-container-path" "$WT")"

[ -f "$WT/.env" ] || cp "$MAIN/.env" "$WT/.env"

# Copy through DEST.partial so DEST only exists after a complete copy; a copy
# killed halfway leaves a .partial that the next run discards.
copy_tree() {
    local src="$1" dest="$2"
    rm -rf "$dest.partial"
    mkdir -p "$(dirname "$dest")"
    cp -a --reflink=auto "$src" "$dest.partial"
    rm -rf "$dest"
    mv "$dest.partial" "$dest"
}

# vendor must be a real copy: Composer resolves paths from the autoloader's own
# location, so a symlink would make the worktree load the main checkout's code.
[ -f "$WT/vendor/autoload.php" ] || copy_tree "$MAIN/vendor" "$WT/vendor"

if [ ! -f "$WT/public/build/manifest.json" ] && [ -d "$MAIN/public/build" ]; then
    copy_tree "$MAIN/public/build" "$WT/public/build"
fi

COMPOSER_LOG="$(mktemp)"
trap 'rm -f "$COMPOSER_LOG"' EXIT
if ! (cd "$MAIN" && ddev exec --dir "$CPATH" composer dump-autoload --quiet >"$COMPOSER_LOG" 2>&1); then
    grep -v -E 'nested project|To use the nested' "$COMPOSER_LOG" >&2 || true
    echo "worktree-setup: composer dump-autoload failed" >&2
    exit 1
fi

echo "worktree-setup: ready. Run commands with: ddev exec --dir $CPATH <cmd>"
