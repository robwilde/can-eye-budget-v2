#!/bin/sh

# GrumPHP hook template (grumphp.yml: hooks_dir). Installed by `grumphp git:init`.
# Runs GrumPHP in DDEV for the main checkout or any linked worktree.

GIT_USER=$(git config user.name)
GIT_EMAIL=$(git config user.email)
COMMIT_MSG_FILE=$1

DIFF=$(git -c diff.mnemonicprefix=false -c diff.noprefix=false --no-pager diff --raw -r -p -m -M --full-index --no-color --staged | cat)

TOP="$(git rev-parse --show-toplevel)"
MAIN="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
RUNNER="$TOP/scripts/grumphp-ddev"
[ -x "$RUNNER" ] || RUNNER="$MAIN/scripts/grumphp-ddev"

if [ -x "$RUNNER" ]; then
    printf "%s\n" "${DIFF}" | "$RUNNER" git:commit-msg "--git-user=$GIT_USER" "--git-email=$GIT_EMAIL" "$COMMIT_MSG_FILE"
elif [ "$(cd "$TOP" && pwd -P)" != "$(cd "$MAIN" && pwd -P)" ]; then
    echo "grumphp commit-msg: scripts/grumphp-ddev not found in $TOP or $MAIN; refusing plain 'ddev exec' from a linked worktree." >&2
    exit 1
else
    (cd "$TOP" && printf "%s\n" "${DIFF}" | ddev exec php vendor/bin/grumphp git:commit-msg "--git-user=$GIT_USER" "--git-email=$GIT_EMAIL" "$COMMIT_MSG_FILE")
fi
