<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
        <testsuite name="Arch">
            <file>tests/Arch.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Every variable below is pinned on all three channels PHP exposes an environment
             variable through: getenv(), $_ENV and $_SERVER. A plain <env> is skipped when the
             variable is already exported, and force="true" overrides getenv() and $_ENV but
             leaves $_SERVER untouched — which is the channel Laravel's Env repository reads
             first. Only the <env force="true"> + <server> pair guarantees the suite cannot be
             redirected by a shell, CI job or direnv profile that exports one of these names
             (e.g. APP_ENV=local turning Ray on, DB_CONNECTION=mysql pointing RefreshDatabase at
             a real database). Verified against PHPUnit's PhpHandler and Laravel's Env repository
             order (phpdotenv's ServerConstAdapter, EnvConstAdapter, then Laravel's PutenvAdapter). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <server name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Blank rather than absent: bootstrap/app.php reports every exception to Sentry
             (#433), so a developer's real SENTRY_DSN would send deliberately thrown test
             failures to the production project (#439). An empty DSN disables the SDK outright
             instead of erroring at boot. -->
        <env name="SENTRY_DSN" value="" force="true"/>
        <server name="SENTRY_DSN" value=""/>
        <!-- Every Context.dev call costs credits, so the suite must never reach the live API
             even with a key exported. Tests mock App\Contracts\ContextDevServiceContract or
             inject a Guzzle MockHandler via App\Services\ContextDevService::withApiKey(). -->
        <env name="CONTEXT_DEV_API_KEY" value="" force="true"/>
        <server name="CONTEXT_DEV_API_KEY" value=""/>
        <!-- Enrichment off by default so a developer's .env cannot turn it on: the transactions
             page reads the Context.dev balance when it is on. Tests that need it set the config. -->
        <env name="CONTEXT_DEV_ENRICHMENT_ENABLED" value="false" force="true"/>
        <server name="CONTEXT_DEV_ENRICHMENT_ENABLED" value="false"/>
    </php>
</phpunit>
